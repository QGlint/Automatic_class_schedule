<Page x:Class="Automatic_class_schedule.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:infra="using:Automatic_class_schedule.Infrastructure"
      mc:Ignorable="d">

    <Page.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <infra:StringMatchToVisibilityConverter x:Key="StringMatchToVisibility" />

        <Style x:Key="RoundButtonBase" TargetType="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="TopButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonBase}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#FFF0F5FF" />
            <Setter Property="Foreground" Value="#FF214E78" />
        </Style>

        <Style x:Key="TopActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource TopButtonStyle}">
            <Setter Property="Background" Value="#FF214E78" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonBase}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#FFF0F5FF" />
            <Setter Property="Foreground" Value="#FF214E78" />
        </Style>

        <Style x:Key="NavActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#FF214E78" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="TagButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonBase}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#FFF5F5F5" />
            <Setter Property="Foreground" Value="#FF214E78" />
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFD9E1EC" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style TargetType="controls:DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <DataTemplate x:Key="ScheduleEntryTemplate">
            <Border Margin="0,0,0,3" Padding="4,3"
                    Background="#FFF8FBFF" BorderBrush="#FFBFD7EE"
                    BorderThickness="1" CornerRadius="4"
                    CanDrag="True" AllowDrop="True"
                    DragStarting="Entry_DragStarting"
                    DragOver="Entry_DragOver" Drop="Entry_Drop">
                <StackPanel>
                    <TextBlock Text="{Binding Subject}" FontSize="12" />
                    <TextBlock Text="{Binding TeacherName}" FontSize="10" Foreground="#FF556070" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="8" Background="#FFF3F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========== 顶部工具按钮栏 ========== -->
        <Border Background="White" CornerRadius="10" BorderBrush="#FFD9E1EC" BorderThickness="1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="新建项目" Command="{Binding NewProjectCommand}" Style="{StaticResource TopButtonStyle}" />
                    <Button Content="加载示例" Command="{Binding SeedSampleDataCommand}" Style="{StaticResource TopButtonStyle}" />
                    <Button Content="保存配置" Command="{Binding SaveCommand}" Style="{StaticResource TopButtonStyle}" />
                    <Button Content="载入配置" Command="{Binding LoadCommand}" Style="{StaticResource TopButtonStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="1" Width="160" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#FF5A6877" Margin="6,0" FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 页面切换栏（缩小版导航栏） ========== -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#FFD9E1EC" BorderThickness="1" Padding="6,2" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="配置" Command="{Binding SelectMainPageCommand}" CommandParameter="配置"
                        Style="{StaticResource TopButtonStyle}"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=配置}" />
                <Button Content="配置" Command="{Binding SelectMainPageCommand}" CommandParameter="配置"
                        Style="{StaticResource TopActiveButtonStyle}"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=配置}" />
                <Button Content="课表" Command="{Binding SelectMainPageCommand}" CommandParameter="课表"
                        Style="{StaticResource TopButtonStyle}"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=课表}" />
                <Button Content="课表" Command="{Binding SelectMainPageCommand}" CommandParameter="课表"
                        Style="{StaticResource TopActiveButtonStyle}"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=课表}" />
                <Button Content="导出" Command="{Binding SelectMainPageCommand}" CommandParameter="导出"
                        Style="{StaticResource TopButtonStyle}"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=导出}" />
                <Button Content="导出" Command="{Binding SelectMainPageCommand}" CommandParameter="导出"
                        Style="{StaticResource TopActiveButtonStyle}"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=导出}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- *********************************************** -->
            <!-- LEFT NAVIGATIONS -->
            <!-- *********************************************** -->

            <!-- ===== 配置导航 ===== -->
            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ConfigPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="配置步骤" FontSize="16" Foreground="#FF214E78" Margin="0,0,0,8" />
                        <Button Content="1. 基础设置" Command="{Binding SelectConfigPageCommand}" CommandParameter="基础设置"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=基础设置}" />
                        <Button Content="1. 基础设置" Command="{Binding SelectConfigPageCommand}" CommandParameter="基础设置"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=基础设置}" />
                        <Button Content="2. 班级配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="班级配置"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=班级配置}" />
                        <Button Content="2. 班级配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="班级配置"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=班级配置}" />
                        <Button Content="3. 课程配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="课程配置"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=课程配置}" />
                        <Button Content="3. 课程配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="课程配置"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=课程配置}" />
                        <Button Content="4. 教师配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="教师配置"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=教师配置}" />
                        <Button Content="4. 教师配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="教师配置"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=教师配置}" />
                        <Button Content="5. 固定课程" Command="{Binding SelectConfigPageCommand}" CommandParameter="固定课程"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=固定课程}" />
                        <Button Content="5. 固定课程" Command="{Binding SelectConfigPageCommand}" CommandParameter="固定课程"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=固定课程}" />
                        <Button Content="6. 自动排课" Command="{Binding SelectConfigPageCommand}" CommandParameter="自动排课"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=自动排课}" />
                        <Button Content="6. 自动排课" Command="{Binding SelectConfigPageCommand}" CommandParameter="自动排课"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=自动排课}" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,8" />
                        <Button Content="检查冲突" Command="{Binding ValidateCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="导入数据" Command="{Binding ImportCommand}" Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 课表导航 ===== -->
            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding SchedulePageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="课表导航" FontSize="16" Foreground="#FF214E78" Margin="0,0,0,6" />
                        <Button Content="年级总表" Command="{Binding SelectViewModeCommand}" CommandParameter="年级总表"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=年级总表}" />
                        <Button Content="年级总表" Command="{Binding SelectViewModeCommand}" CommandParameter="年级总表"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=年级总表}" />
                        <Button Content="班级课表" Command="{Binding SelectViewModeCommand}" CommandParameter="班级课表"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=班级课表}" />
                        <Button Content="班级课表" Command="{Binding SelectViewModeCommand}" CommandParameter="班级课表"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=班级课表}" />
                        <Button Content="教师课表" Command="{Binding SelectViewModeCommand}" CommandParameter="教师课表"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=教师课表}" />
                        <Button Content="教师课表" Command="{Binding SelectViewModeCommand}" CommandParameter="教师课表"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=教师课表}" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,10" />

                        <TextBox PlaceholderText="搜索教师..." Text="{Binding TeacherSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Padding="6,4" />
                        <TextBlock Text="教师" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding FilteredTeachers}" MaxHeight="160">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Click="TeacherButton_Click" Style="{StaticResource TagButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox PlaceholderText="筛选年级..." Text="{Binding GradeFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" Padding="6,4" />
                        <TextBlock Text="年级" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding FilteredGrades}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding GradeName}" Click="GradeButton_Click" Style="{StaticResource TagButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="班级" FontWeight="SemiBold" Margin="0,8,0,6" />
                        <ItemsControl ItemsSource="{Binding FilteredClasses}" MaxHeight="160">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DisplayName}" Click="ClassButton_Click" Style="{StaticResource TagButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,10" />
                        <Button Content="5 天制" Command="{Binding UseFiveDayCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="7 天制" Command="{Binding UseSevenDayCommand}" Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 导出导航 ===== -->
            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ExportPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="导出导航" FontSize="16" Foreground="#FF214E78" Margin="0,0,0,6" />
                        <Button Content="导出课表" Command="{Binding ExportCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="导入数据" Click="ImportButton_Click" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="保存数据" Command="{Binding SaveCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,10" />
                        <TextBlock Text="输出目录" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExportFolderPath}" TextWrapping="Wrap" Foreground="#FF5A6877" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="本地数据文件" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DataFilePath}" TextWrapping="Wrap" Foreground="#FF5A6877" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- *********************************************** -->
            <!-- CENTER CONTENT -->
            <!-- *********************************************** -->

            <!-- ===== 基础设置 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsBasicSettingsVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="基础设置" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="配置学校基本信息和每天节次。" Foreground="#FF5A6877" Margin="0,0,0,12" />

                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="学校信息" FontWeight="SemiBold" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="学校名称" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Padding="6,4" />
                                    <TextBlock Grid.Row="1" Text="每周天数" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding DaysPerWeek}" Margin="0,0,0,6" Width="100" HorizontalAlignment="Left">
                                        <x:Int32>5</x:Int32>
                                        <x:Int32>6</x:Int32>
                                        <x:Int32>7</x:Int32>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Text="上午节数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MorningPeriods, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="60" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="3" Text="下午节数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AfternoonPeriods, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="60" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="4" Text="晚自习" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Row="4" Grid.Column="1" IsOn="{Binding IncludeEveningSelfStudy}" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="5" Text="晚自习节数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EveningPeriods, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="60" HorizontalAlignment="Left"
                                             IsEnabled="{Binding IncludeEveningSelfStudy}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="提示：上午节数 + 下午节数 + 晚自习节数 = 每天总节数。" Foreground="#FF5A6877" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 班级配置 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsClassConfigVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="班级配置" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="配置年级和每个年级的班级数。" Foreground="#FF5A6877" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="添加年级和班级数，点击生成班级创建具体班级。" Foreground="#FF5A6877" VerticalAlignment="Center" FontSize="13" />
                                    <Button Grid.Column="1" Content="生成班级" Command="{Binding GenerateClassesCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" Margin="10,0,0,0" />
                                </Grid>
                                <controls:DataGrid ItemsSource="{Binding GradeInputs}" SelectedItem="{Binding SelectedGradeInput, Mode=TwoWay}">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="年级" Binding="{Binding GradeName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="班级数" Binding="{Binding ClassCount, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="已生成班级" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="共 " Foreground="#FF5A6877" />
                                    <TextBlock Text="{Binding TotalClasses}" Foreground="#FF5A6877" />
                                    <TextBlock Text=" 个班级" Foreground="#FF5A6877" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Classes}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="3" Padding="8,5" Background="#FFF0F5FF" CornerRadius="5">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#FF214E78" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 课程配置 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsSubjectConfigVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="课程配置" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="配置课程名称、类别、每周课时和分布规则。" Foreground="#FF5A6877" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="课程列表" FontWeight="SemiBold" />
                                <controls:DataGrid ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject, Mode=TwoWay}">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="课程" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="类别" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                        <controls:DataGridTextColumn Header="周课时" Binding="{Binding DefaultWeeklyCount, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="分布规则" FontWeight="SemiBold" />
                                <TextBlock Text="选择课程在每周的分布方式。" Foreground="#FF5A6877" />
                                <ComboBox SelectedValue="{Binding SelectedSubject.Name}" Margin="0,6,0,0" Width="180" HorizontalAlignment="Left">
                                    <x:String>每天一次</x:String>
                                    <x:String>均衡分布</x:String>
                                    <x:String>集中安排</x:String>
                                    <x:String>上午优先</x:String>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Button Content="生成教师配置示例" Command="{Binding GenerateAssignmentsCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <TextBlock Text="点击可基于当前课程和班级自动生成教师授课安排。" Foreground="#FF5A6877" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 教师配置 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsTeacherConfigVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="教师配置" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="配置教师授课安排：教师 + 科目 + 所带班级。" Foreground="#FF5A6877" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="每行配置一个教师，可带多个班级（用、分隔）。" Foreground="#FF5A6877" VerticalAlignment="Center" FontSize="13" />
                                    <Button Grid.Column="1" Content="生成需求" Command="{Binding GenerateRequirementsCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" Margin="10,0,0,0" />
                                </Grid>
                                <controls:DataGrid ItemsSource="{Binding TeacherAssignments}" SelectedItem="{Binding SelectedTeacherAssignment, Mode=TwoWay}">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="教师" Binding="{Binding TeacherName, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                        <controls:DataGridTextColumn Header="科目" Binding="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <controls:DataGridTextColumn Header="所带班级" Binding="{Binding ClassNames, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="周课时" Binding="{Binding WeeklyCount, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <controls:DataGridTextColumn Header="分布规则" Binding="{Binding DistributionRule, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>
                        <Button Content="从课程生成教师示例" Command="{Binding GenerateAssignmentsCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 固定课程 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsFixedLessonConfigVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="固定课程" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="配置全校、年级、班级或教师级别的固定课程。" Foreground="#FF5A6877" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="固定课程列表" FontWeight="SemiBold" />
                                <controls:DataGrid ItemsSource="{Binding FixedLessons}" SelectedItem="{Binding SelectedFixedLesson, Mode=TwoWay}">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="范围" Binding="{Binding ScopeValue, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                        <controls:DataGridTextColumn Header="星期" Binding="{Binding DayIndex, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <controls:DataGridTextColumn Header="节次" Binding="{Binding PeriodIndex, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                        <controls:DataGridTextColumn Header="课程" Binding="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <controls:DataGridTextColumn Header="原因" Binding="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 自动排课 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsAutoScheduleVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="自动排课" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="确认所有配置后点击下方按钮生成课表。" Foreground="#FF5A6877" Margin="0,0,0,12" />

                        <Border Background="#FFF0F5FF" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="配置概览" FontSize="16" Foreground="#FF214E78" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="学校" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Column="1" Text="{Binding SchoolName}" Margin="10,0" />
                                    <TextBlock Grid.Row="1" Text="班级数" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalClasses}" Margin="10,0" />
                                    <TextBlock Grid.Row="2" Text="课程数" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalSubjects}" Margin="10,0" />
                                    <TextBlock Grid.Row="3" Text="教师安排" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalAssignments}" Margin="10,0" />
                                    <TextBlock Grid.Row="4" Text="授课需求" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalRequirements}" Margin="10,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Value="{Binding ProgressValue}" Maximum="1" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Grid.Column="1" Content="开始排课" Command="{Binding AutoScheduleCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" MinWidth="100" />
                            <Button Grid.Column="2" Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" Margin="6,0,0,0" />
                        </Grid>

                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,12" />
                        <Button Content="检查冲突" Command="{Binding ValidateCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" HorizontalAlignment="Left" />
                        <controls:DataGrid ItemsSource="{Binding Conflicts}" IsReadOnly="True" Margin="0,6,0,0" MaxHeight="180">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="60" />
                                <controls:DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80" />
                                <controls:DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="*" />
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>

                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,10" />
                        <TextBlock Text="操作记录" FontWeight="SemiBold" />
                        <ListBox ItemsSource="{Binding ActivityLog}" MaxHeight="120" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 课表视图 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding SchedulePageVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#FFF0F5FF" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SchoolName}" FontSize="18" Foreground="#FF214E78" />
                                <TextBlock Text="{Binding CurrentScopeSummary}" Foreground="#FF5A6877" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TotalScheduleEntries}" VerticalAlignment="Center" Foreground="#FF5A6877" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 左侧节次标签（固定在整体最左边） -->
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding TimetableDays[0].Cells}" Margin="0,0,4,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="72" Margin="0,0,0,8" Padding="4" Background="#FFF0F5FF" CornerRadius="6" VerticalAlignment="Stretch">
                                            <TextBlock Text="{Binding PeriodLabel}" FontSize="11" Foreground="#FF214E78"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       TextAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 周几列 -->
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding TimetableDays}" AllowDrop="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="220" Margin="0,0,8,0" Padding="8" Background="White" BorderBrush="#FFD9E1EC" BorderThickness="1" CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Border Background="#FFF0F5FF" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding DayName}" FontSize="16" Foreground="#FF214E78" HorizontalAlignment="Center" />
                                                </Border>
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,0,0,6" Padding="6" Background="White" BorderBrush="#FFD8E3F0" BorderThickness="1" CornerRadius="6">
                                                                    <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource ScheduleEntryTemplate}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== 导出页 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ExportPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="导出" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="导出课表到 Excel 文件。" Foreground="#FF5A6877" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="导出操作" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="导出课表" Command="{Binding ExportCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" Margin="0,0,8,0" />
                                    <Button Content="导入数据" Click="ImportButton_Click" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="输出目录" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ExportFolderPath}" TextWrapping="Wrap" Foreground="#FF5A6877" FontSize="12" />
                                <TextBlock Text="本地数据文件" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding DataFilePath}" TextWrapping="Wrap" Foreground="#FF5A6877" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="操作记录" FontWeight="SemiBold" />
                                <ListBox ItemsSource="{Binding ActivityLog}" MaxHeight="250" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- *********************************************** -->
            <!-- RIGHT: Detail Panel -->
            <!-- *********************************************** -->
            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="详情" FontSize="16" Foreground="#FF214E78" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,8" />
                        <TextBlock Text="当前选中" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.Subject}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.TeacherName}" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.ClassName}" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.SlotLabel}" Margin="0,0,0,6" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,8" />
                        <TextBlock Text="冲突提示" FontWeight="SemiBold" />
                        <controls:DataGrid ItemsSource="{Binding Conflicts}" IsReadOnly="True" MaxHeight="180">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="*" />
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>