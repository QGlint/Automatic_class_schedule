<Page x:Class="Automatic_class_schedule.MainPage"
      x:Name="SchedulePageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:infra="using:Automatic_class_schedule.Infrastructure"
      mc:Ignorable="d">

    <Page.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <infra:StringMatchToVisibilityConverter x:Key="StringMatchToVisibility" />
        <infra:BoolToBrushConverter x:Key="BoolToBrush" />
        <infra:BoolToForegroundConverter x:Key="BoolToForeground" />
        <infra:DistributionRuleOptionsProvider x:Key="DistRuleProvider" />
        <infra:CategoryOptionsProvider x:Key="CategoryProvider" />
        <infra:FixedLessonScopeProvider x:Key="ScopeProvider" />

        <Style x:Key="RoundButtonBase" TargetType="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="TopButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonBase}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#FFF0F5FF" />
            <Setter Property="Foreground" Value="#FF214E78" />
        </Style>

        <Style x:Key="TopActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource TopButtonStyle}">
            <Setter Property="Background" Value="#FF214E78" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonBase}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#FFF0F5FF" />
            <Setter Property="Foreground" Value="#FF214E78" />
        </Style>

        <Style x:Key="NavActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#FF214E78" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="TagButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonBase}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Foreground" Value="#FF214E78" />
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFD9E1EC" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style TargetType="controls:DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <DataTemplate x:Key="RecentProjectItemTemplate">
            <Border Padding="12,10" Margin="0,0,0,4" Background="#FFFAFBFC"
                    CornerRadius="6" BorderBrush="#FFE0E6EF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                               Foreground="#FF214E78" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding LastOpen}" FontSize="11" Foreground="#FF8E9FB6" />
                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#FFB0BFD1"
                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ScheduleEntryTemplate">
            <Border Margin="0,0,0,2" Padding="3,2"
                    Background="#FFF8FBFF" BorderBrush="#FFBFD7EE"
                    BorderThickness="1" CornerRadius="3"
                    CanDrag="True" AllowDrop="True"
                    DragStarting="Entry_DragStarting"
                    DragOver="Entry_DragOver" Drop="Entry_Drop">
                <TextBlock FontSize="11" TextWrapping="NoWrap">
                    <Run Text="{Binding ClassName}" Foreground="#FF7A8BA8" />
                    <Run Text=" " />
                    <Run Text="{Binding Subject}" />
                    <Run Text=" " />
                    <Run Text="{Binding TeacherName}" Foreground="#FF556070" />
                </TextBlock>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="8" Background="#FFF3F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========== 可折叠顶部工具栏 ========== -->
        <Border Background="#FFFAFBFC" CornerRadius="8" BorderBrush="#FFE0E6EF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 折叠切换行 -->
                <Grid Padding="6,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="新建项目" x:Name="NewProjectButton" Click="NewProject_Click" Style="{StaticResource TopButtonStyle}" />
                        <Button Content="打开项目" x:Name="OpenProjectButton" Click="OpenProject_Click" Style="{StaticResource TopButtonStyle}" />
                        <Button Content="打开最近项目" Click="OpenRecentProject_Click" Style="{StaticResource TopButtonStyle}" />
                        <Button Content="保存项目" x:Name="SaveProjectButton" Click="SaveProject_Click" Style="{StaticResource TopButtonStyle}" />
                        <Button Content="关闭项目" Click="CloseProject_Click" Style="{StaticResource TopButtonStyle}" />
                        <TextBlock Text="{Binding ProjectFileName}" FontSize="12" Foreground="#FF5A6877" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Content="加载示例" Command="{Binding SeedSampleDataCommand}" Style="{StaticResource TopButtonStyle}" Margin="12,0,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ToggleToolbarCommand}" Style="{StaticResource TopButtonStyle}" MinWidth="28" Padding="4,2">
                        <TextBlock x:Name="ToolbarToggleIcon" Text="▲" FontSize="10" />
                    </Button>
                </Grid>
                <!-- 工具栏扩展区域 -->
                <Border Grid.Row="1" BorderBrush="#FFE0E6EF" BorderThickness="0,1,0,0" Padding="6,4"
                        Visibility="{Binding IsToolbarExpanded, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="|" Foreground="#FFD9E1EC" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#FF5A6877" Margin="6,0" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ProgressBar Value="{Binding ProgressValue}" Maximum="1" Width="120" Margin="0,0,6,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========== 主导航栏（配置 / 课表 / 导出） ========== -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#FFD9E1EC" BorderThickness="1" Padding="0" Margin="0,6,0,0"
                Visibility="{Binding HasActiveProject, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="⚙ 配置" Command="{Binding SelectMainPageCommand}" CommandParameter="配置"
                        Height="48" FontSize="16" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="0"
                        Background="#FFF0F5FF" Foreground="#FF214E78"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=配置}" />
                <Button Content="⚙ 配置" Command="{Binding SelectMainPageCommand}" CommandParameter="配置"
                        Height="48" FontSize="16" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="0"
                        Background="#FF214E78" Foreground="White"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=配置}" />
                <Button Grid.Column="1" Content="📅 课表" Command="{Binding SelectMainPageCommand}" CommandParameter="课表"
                        Height="48" FontSize="16" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="0"
                        Background="#FFF0F5FF" Foreground="#FF214E78"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=课表}" />
                <Button Grid.Column="1" Content="📅 课表" Command="{Binding SelectMainPageCommand}" CommandParameter="课表"
                        Height="48" FontSize="16" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="0"
                        Background="#FF214E78" Foreground="White"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=课表}" />
                <Button Grid.Column="2" Content="📤 导出" Command="{Binding SelectMainPageCommand}" CommandParameter="导出"
                        Height="48" FontSize="16" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="0"
                        Background="#FFF0F5FF" Foreground="#FF214E78"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=导出}" />
                <Button Grid.Column="2" Content="📤 导出" Command="{Binding SelectMainPageCommand}" CommandParameter="导出"
                        Height="48" FontSize="16" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="0"
                        Background="#FF214E78" Foreground="White"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=导出}" />
            </Grid>
        </Border>

        <!-- ========== 主内容区域 ========== -->
        <Grid Grid.Row="2" Margin="0,8,0,0"
              Visibility="{Binding HasActiveProject, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <!-- *********************************************** -->
            <!-- LEFT NAVIGATIONS -->
            <!-- *********************************************** -->

            <!-- ===== 配置导航 ===== -->
            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ConfigPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="配置步骤" FontSize="16" Foreground="#FF214E78" Margin="0,0,0,8" />
                        <Button Content="1. 基础设置" Command="{Binding SelectConfigPageCommand}" CommandParameter="基础设置"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=基础设置}" />
                        <Button Content="1. 基础设置" Command="{Binding SelectConfigPageCommand}" CommandParameter="基础设置"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=基础设置}" />
                        <Button Content="2. 课程配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="课程配置"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=课程配置}" />
                        <Button Content="2. 课程配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="课程配置"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=课程配置}" />
                        <Button Content="3. 教师配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="教师配置"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=教师配置}" />
                        <Button Content="3. 教师配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="教师配置"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=教师配置}" />
                        <Button Content="4. 自动排课" Command="{Binding SelectConfigPageCommand}" CommandParameter="自动排课"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=自动排课}" />
                        <Button Content="4. 自动排课" Command="{Binding SelectConfigPageCommand}" CommandParameter="自动排课"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=自动排课}" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,8" />
                        <Button Content="检查" Command="{Binding ValidateCommand}" Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 课表导航 ===== -->
            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding SchedulePageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="课表导航" FontSize="16" Foreground="#FF214E78" Margin="0,0,0,6" />
                        <Button Content="年级总表" Command="{Binding SelectViewModeCommand}" CommandParameter="年级总表"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=年级总表}" />
                        <Button Content="年级总表" Command="{Binding SelectViewModeCommand}" CommandParameter="年级总表"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=年级总表}" />
                        <Button Content="班级课表" Command="{Binding SelectViewModeCommand}" CommandParameter="班级课表"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=班级课表}" />
                        <Button Content="班级课表" Command="{Binding SelectViewModeCommand}" CommandParameter="班级课表"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=班级课表}" />
                        <Button Content="教师课表" Command="{Binding SelectViewModeCommand}" CommandParameter="教师课表"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=教师课表}" />
                        <Button Content="教师课表" Command="{Binding SelectViewModeCommand}" CommandParameter="教师课表"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=教师课表}" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,10" />

                        <StackPanel Visibility="{Binding IsTeacherViewMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBox PlaceholderText="搜索教师..." Text="{Binding TeacherSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Padding="6,4" />
                            <TextBlock Text="教师" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding FilteredTeachers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}" Click="TeacherButton_Click" Style="{StaticResource TagButtonStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsGradeViewMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBox PlaceholderText="筛选年级..." Text="{Binding GradeFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" Padding="6,4" />
                            <TextBlock Text="年级" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding FilteredGrades}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding GradeName}" Click="GradeButton_Click" Style="{StaticResource TagButtonStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsClassViewMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="班级" FontWeight="SemiBold" Margin="0,8,0,6" />
                            <ItemsControl ItemsSource="{Binding FilteredClasses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayName}" Click="ClassButton_Click" Style="{StaticResource TagButtonStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 导出导航 ===== -->
            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ExportPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="导出导航" FontSize="16" Foreground="#FF214E78" Margin="0,0,0,6" />
                        <Button Content="导出课表" Command="{Binding ExportCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="导入数据" Click="ImportButton_Click" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="保存数据" Command="{Binding SaveCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,10" />
                        <TextBlock Text="输出目录" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExportFolderPath}" TextWrapping="Wrap" Foreground="#FF5A6877" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="本地数据文件" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DataFilePath}" TextWrapping="Wrap" Foreground="#FF5A6877" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- *********************************************** -->
            <!-- CENTER CONTENT -->
            <!-- *********************************************** -->

            <!-- ===== 基础设置 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsBasicSettingsVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="基础设置" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="配置每周天数、每天节次和晚自习设置。支持年级个性化配置。" Foreground="#FF5A6877" Margin="0,0,0,12" />

                        <!-- Tab 切换按钮行 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" x:Name="SettingsTabPanel">
                            <Button x:Name="TabBtnGlobal" Content="全局" Click="SettingsTab_Click" Tag="0"
                                    Height="36" MinWidth="72" Margin="0,0,6,0" Padding="12,4"
                                    CornerRadius="6" FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                                    Background="#FF214E78" Foreground="White" />
                            <Button x:Name="TabBtnGrade7" Content="七年级" Click="SettingsTab_Click" Tag="1"
                                    Height="36" MinWidth="72" Margin="0,0,6,0" Padding="12,4"
                                    CornerRadius="6" FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                                    Background="#FFF0F5FF" Foreground="#FF214E78" />
                            <Button x:Name="TabBtnGrade8" Content="八年级" Click="SettingsTab_Click" Tag="2"
                                    Height="36" MinWidth="72" Margin="0,0,6,0" Padding="12,4"
                                    CornerRadius="6" FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                                    Background="#FFF0F5FF" Foreground="#FF214E78" />
                            <Button x:Name="TabBtnGrade9" Content="九年级" Click="SettingsTab_Click" Tag="3"
                                    Height="36" MinWidth="72" Margin="0,0,6,0" Padding="12,4"
                                    CornerRadius="6" FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                                    Background="#FFF0F5FF" Foreground="#FF214E78" />
                        </StackPanel>

                        <!-- 全局设置面板 -->
                        <Border Style="{StaticResource SectionBorderStyle}"
                                Visibility="{Binding IsGlobalSettingsTab, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="每周天数" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding DaysPerWeek, Mode=TwoWay}" Margin="0,0,0,6" Width="100" HorizontalAlignment="Left">
                                        <x:Int32>5</x:Int32>
                                        <x:Int32>6</x:Int32>
                                        <x:Int32>7</x:Int32>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="上午节数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MorningPeriods, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=4}" Margin="0,0,0,6" Width="60" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="2" Text="下午节数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AfternoonPeriods, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=3}" Margin="0,0,0,6" Width="60" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="3" Text="晚自习" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Row="3" Grid.Column="1" IsOn="{Binding IncludeEveningSelfStudy, Mode=TwoWay}" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="4" Text="晚自习节数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EveningPeriods, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=2}" Margin="0,0,0,6" Width="60" HorizontalAlignment="Left"
                                             IsEnabled="{Binding IncludeEveningSelfStudy}" />
                                    <TextBlock Grid.Row="5" Text="晚自习天数" VerticalAlignment="Center" />
                                    <ItemsControl Grid.Row="5" Grid.Column="1" ItemsSource="{Binding EveningDayItems}" Margin="0,0,0,6"
                                                  IsEnabled="{Binding IncludeEveningSelfStudy}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}" Click="EveningDayButton_Click"
                                                        Height="32" MinWidth="44" Margin="0,0,4,0" Padding="8,4"
                                                        CornerRadius="6" FontSize="13" BorderThickness="0"
                                                        Background="{Binding IsSelected, Converter={StaticResource BoolToBrush}}"
                                                        Foreground="{Binding IsSelected, Converter={StaticResource BoolToForeground}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="6" Text="班级数" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="七年级" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBox Text="{Binding Grade7ClassCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=8}" Width="50" Margin="0,0,12,0" />
                                        <TextBlock Text="八年级" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBox Text="{Binding Grade8ClassCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=8}" Width="50" Margin="0,0,12,0" />
                                        <TextBlock Text="九年级" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBox Text="{Binding Grade9ClassCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=6}" Width="50" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 年级个性化设置面板 -->
                        <Border Style="{StaticResource SectionBorderStyle}"
                                Visibility="{Binding IsGradeSettingsTab, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <ToggleSwitch Header="使用个性化配置" IsOn="{Binding SelectedGradeConfig.UseCustomSettings, Mode=TwoWay}" Margin="0,0,0,8" />

                                <!-- 继承全局提示 -->
                                <TextBlock Text="当前继承全局配置，开启个性化配置后可编辑。" Foreground="#FF8E9FB6" FontSize="13"
                                           Margin="0,4,0,8">
                                    <TextBlock.Visibility>
                                        <Binding Path="SelectedGradeConfig.UseCustomSettings" Converter="{StaticResource BoolToVisibility}" ConverterParameter="Inverse" />
                                    </TextBlock.Visibility>
                                </TextBlock>

                                <!-- 年级自定义配置表单 -->
                                <Grid Visibility="{Binding SelectedGradeConfig.UseCustomSettings, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="每周天数" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedGradeConfig.DaysPerWeek, Mode=TwoWay}" Margin="0,0,0,6" Width="100" HorizontalAlignment="Left">
                                        <x:Int32>5</x:Int32>
                                        <x:Int32>6</x:Int32>
                                        <x:Int32>7</x:Int32>
                                    </ComboBox>
                                    <TextBlock Grid.Row="1" Text="上午节数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedGradeConfig.MorningPeriods, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=4}" Margin="0,0,0,6" Width="60" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="2" Text="下午节数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedGradeConfig.AfternoonPeriods, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=3}" Margin="0,0,0,6" Width="60" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="3" Text="晚自习" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Row="3" Grid.Column="1" IsOn="{Binding SelectedGradeConfig.IncludeEveningSelfStudy, Mode=TwoWay}" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="4" Text="晚自习节数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedGradeConfig.EveningPeriods, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=2}" Margin="0,0,0,6" Width="60" HorizontalAlignment="Left"
                                             IsEnabled="{Binding SelectedGradeConfig.IncludeEveningSelfStudy}" />
                                    <TextBlock Grid.Row="5" Text="晚自习天数" VerticalAlignment="Center" />
                                    <ItemsControl Grid.Row="5" Grid.Column="1" ItemsSource="{Binding GradeEveningDayItems}" Margin="0,0,0,6"
                                                  IsEnabled="{Binding SelectedGradeConfig.IncludeEveningSelfStudy}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Label}" Click="GradeEveningDayButton_Click"
                                                        Height="32" MinWidth="44" Margin="0,0,4,0" Padding="8,4"
                                                        CornerRadius="6" FontSize="13" BorderThickness="0"
                                                        Background="{Binding IsSelected, Converter={StaticResource BoolToBrush}}"
                                                        Foreground="{Binding IsSelected, Converter={StaticResource BoolToForeground}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="提示：上午节数 + 下午节数 + 晚自习节数 = 每天总节数。年级默认继承全局配置，可单独覆盖。" Foreground="#FF5A6877" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 课程配置 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsSubjectConfigVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="课程配置" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="配置课程名称、类别、每周课时和分布规则。" Foreground="#FF5A6877" Margin="0,0,0,10" />

                        <!-- 课程模板工具栏 -->
                        <Border Style="{StaticResource SectionBorderStyle}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="配置方案" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding CourseTemplates}" SelectedItem="{Binding SelectedCourseTemplate, Mode=TwoWay}"
                                          Width="180" Margin="0,0,8,0" />
                                <Button Content="载入" Command="{Binding LoadCourseTemplateCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" Margin="0,0,6,0" />
                                <Button Content="保存配置" Click="SaveTemplateButton_Click" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" Margin="0,0,6,0" />
                                <Button Content="删除" Command="{Binding DeleteCourseTemplateCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FFCC4444" />
                            </StackPanel>
                        </Border>
                        <!-- 年级子标签 + 固定时间标签 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ItemsControl ItemsSource="{Binding GradeInputs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding GradeName}" Click="SubjectGradeTabButton_Click"
                                                Height="36" MinWidth="80" Margin="0,0,6,0" Padding="12,4"
                                                CornerRadius="6" FontSize="14" FontWeight="SemiBold"
                                                BorderThickness="0"
                                                Background="#FFF0F5FF" Foreground="#FF214E78" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="固定时间" Click="FixedTimeTabButton_Click"
                                    Height="36" MinWidth="80" Margin="0,0,6,0" Padding="12,4"
                                    CornerRadius="6" FontSize="14" FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Background="#FFF0F5FF" Foreground="#FF214E78" />
                        </StackPanel>

                        <!-- 课程列表（年级标签时显示） -->
                        <Border Style="{StaticResource SectionBorderStyle}"
                                Visibility="{Binding IsSubjectGridVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="课程列表" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="添加" Command="{Binding AddSubjectCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" Margin="0,0,6,0" />
                                    <Button Grid.Column="2" Content="删除" Command="{Binding DeleteSubjectCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" />
                                </Grid>
                                <controls:DataGrid ItemsSource="{Binding FilteredSubjects}" SelectedItem="{Binding SelectedSubject, Mode=TwoWay}"
                                                   IsReadOnly="False" AutoGenerateColumns="False"
                                                   GridLinesVisibility="Horizontal" RowHeight="36">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="年级" Binding="{Binding GradeName}" Width="*" IsReadOnly="True" />
                                        <controls:DataGridTemplateColumn Header="课程" Width="*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="4,2" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                        <controls:DataGridTemplateColumn Header="类别" Width="*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Options, Source={StaticResource CategoryProvider}}"
                                                              SelectedItem="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              BorderThickness="0" MinHeight="28" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                        <controls:DataGridTemplateColumn Header="周课时" Width="*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding DefaultWeeklyCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="4,2" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                        <controls:DataGridTemplateColumn Header="分布规则" Width="*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Options, Source={StaticResource DistRuleProvider}}"
                                                              SelectedItem="{Binding DistributionRule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              BorderThickness="0" MinHeight="28" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- 固定课程列表（固定时间标签时显示） -->
                        <Border Style="{StaticResource SectionBorderStyle}"
                                Visibility="{Binding IsFixedTimeTabSelected, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="固定课程列表" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="添加" Command="{Binding AddFixedLessonCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" Margin="0,0,6,0" />
                                    <Button Grid.Column="2" Content="删除" Command="{Binding DeleteFixedLessonCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FFCC4444" />
                                </Grid>
                                <controls:DataGrid ItemsSource="{Binding FixedLessons}" SelectedItem="{Binding SelectedFixedLesson, Mode=TwoWay}"
                                                   IsReadOnly="False" AutoGenerateColumns="False"
                                                   GridLinesVisibility="Horizontal" RowHeight="36">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTemplateColumn Header="范围" Width="*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Options, Source={StaticResource ScopeProvider}}"
                                                              SelectedItem="{Binding ScopeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              BorderThickness="0" MinHeight="28" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                        <controls:DataGridTemplateColumn Header="星期" Width="*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding DayIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="4,2" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                        <controls:DataGridTemplateColumn Header="第几节" Width="*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding PeriodIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="4,2" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                        <controls:DataGridTemplateColumn Header="课程名称" Width="*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="4,2" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 教师配置 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsTeacherConfigVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="教师配置" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="配置教师授课安排：教师 + 科目 + 所带班级。" Foreground="#FF5A6877" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="教师列表" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="添加" Command="{Binding AddTeacherAssignmentCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" Margin="0,0,6,0" />
                                    <Button Grid.Column="2" Content="删除" Command="{Binding DeleteTeacherAssignmentCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FFCC4444" Margin="0,0,6,0" />
                                    <Button Grid.Column="3" Content="导入名单" Command="{Binding ImportTeacherListCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" Margin="0,0,6,0" />
                                    <Button Grid.Column="4" Content="生成教师" Command="{Binding GenerateTeachersCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" Margin="0,0,6,0" />
                                    <Button Grid.Column="5" Content="导出模板" Command="{Binding GenerateTeacherTemplateCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" />
                                </Grid>
                                <controls:DataGrid ItemsSource="{Binding TeacherAssignments}" SelectedItem="{Binding SelectedTeacherAssignment, Mode=TwoWay}"
                                                   IsReadOnly="False" AutoGenerateColumns="False"
                                                   GridLinesVisibility="Horizontal" RowHeight="40">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTemplateColumn Header="教师" Width="*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding TeacherName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="4,2" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                        <controls:DataGridTemplateColumn Header="科目" Width="*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="4,2" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                        <controls:DataGridTemplateColumn Header="班级" Width="2*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding ClassNames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                                             TextWrapping="Wrap" AcceptsReturn="False" Padding="4,2" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                        <controls:DataGridTemplateColumn Header="周课时" Width="*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding WeeklyCountInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="{Binding WeeklyCountPlaceholder}"
                                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="4,2" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 自动排课 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsAutoScheduleVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="自动排课" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="确认所有配置后点击下方按钮生成课表。" Foreground="#FF5A6877" Margin="0,0,0,12" />

                        <Border Background="#FFF0F5FF" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="配置概览" FontSize="16" Foreground="#FF214E78" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="班级数" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalClasses}" Margin="10,0" />
                                    <TextBlock Grid.Row="1" Text="课程数" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalSubjects}" Margin="10,0" />
                                    <TextBlock Grid.Row="2" Text="教师安排" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalAssignments}" Margin="10,0" />
                                    <TextBlock Grid.Row="3" Text="授课需求" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalRequirements}" Margin="10,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Value="{Binding ProgressValue}" Maximum="1" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Grid.Column="1" Content="开始排课" Command="{Binding AutoScheduleCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" MinWidth="100" />
                            <Button Grid.Column="2" Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" Margin="6,0,0,0" />
                        </Grid>

                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,12" />
                        <Button Content="检查" Command="{Binding ValidateCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" HorizontalAlignment="Left" />
                        <controls:DataGrid ItemsSource="{Binding Conflicts}" IsReadOnly="True" Margin="0,6,0,0" MaxHeight="220"
                                           AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="级别" Binding="{Binding SeverityText}" Width="50" />
                                <controls:DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="72" />
                                <controls:DataGridTextColumn Header="对象" Binding="{Binding Target}" Width="70" />
                                <controls:DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="*" />
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>

                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,10" />
                        <TextBlock Text="操作记录" FontWeight="SemiBold" />
                        <ListBox ItemsSource="{Binding ActivityLog}" MaxHeight="120" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 课表视图 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding SchedulePageVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#FFF0F5FF" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ProjectFileName}" FontSize="18" Foreground="#FF214E78" />
                                <TextBlock Text="{Binding CurrentScopeSummary}" Foreground="#FF5A6877" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TotalScheduleEntries}" VerticalAlignment="Center" Foreground="#FF5A6877" />
                        </Grid>
                    </Border>

                    <!-- 年级子标签 + 局部调整按钮 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <ItemsControl ItemsSource="{Binding GradeInputs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Button Content="{Binding GradeName}" Click="GradeTabButton_Click"
                                                Height="36" MinWidth="80" Margin="0,0,6,0" Padding="12,4"
                                                CornerRadius="6" FontSize="14" FontWeight="SemiBold"
                                                BorderThickness="0"
                                                Background="#FFF0F5FF" Foreground="#FF214E78" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="局部调整" Command="{Binding LocalAdjustCommand}"
                                Height="36" Margin="16,0,0,0" Padding="14,4"
                                CornerRadius="6" FontSize="13" FontWeight="Bold"
                                Background="#FFF0F5FF" Foreground="#FF0066CC" BorderThickness="0" />
                    </StackPanel>

                    <!-- ===== 年级总表（班级行 × 天×节次列） ===== -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsGradeViewMode, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <!-- 拖拽提示 -->
                            <Border Background="#FFFDF6E3" Padding="8,4" Margin="0,0,0,4">
                                <TextBlock Text="提示：拖动课程可调整位置，冲突课程将标红显示" FontSize="12" Foreground="#FF8B6914" />
                            </Border>
                            <!-- 双层表头 -->
                            <Border Background="#FFF0F5FF" BorderBrush="#FFD9E1EC" BorderThickness="1,1,1,0">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 班级列标题 -->
                                    <Border Width="70" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4">
                                        <TextBlock Text="班级" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- 天列组 -->
                                    <ItemsControl ItemsSource="{Binding GradeDayHeaders}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <!-- 第一行：天名称 -->
                                                    <Border BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4">
                                                        <TextBlock Text="{Binding DayName}" FontSize="12" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center" />
                                                    </Border>
                                                    <!-- 第二行：节次编号 -->
                                                    <ItemsControl ItemsSource="{Binding PeriodNumbers}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="48" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="2,1">
                                                                    <TextBlock Text="{Binding}" FontSize="11"
                                                                               HorizontalAlignment="Center" Foreground="#FF5A6877" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 班级数据行 -->
                            <ItemsControl ItemsSource="{Binding GradeClassRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFD9E1EC" BorderThickness="1,0,1,1" Background="#FFFAFBFC">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- 班级名称 -->
                                                <Border Width="70" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,0" Padding="4"
                                                        Background="{Binding HeaderBackground}">
                                                    <TextBlock Text="{Binding ClassName}" FontSize="12"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <!-- 单元格 -->
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="48" MinHeight="32" BorderThickness="0,0,1,0" Padding="2,1"
                                                                    CanDrag="True" AllowDrop="True"
                                                                    DragStarting="GridCell_DragStarting"
                                                                    DragOver="GridCell_DragOver"
                                                                    Drop="GridCell_Drop"
                                                                    Background="{Binding CellBackground}">
                                                                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                                                                    <TextBlock Text="{Binding Subject}" FontSize="18" TextWrapping="Wrap"
                                                                               Foreground="{Binding SubjectForeground}" />
                                                                    <TextBlock Text="{Binding TeacherName}" FontSize="14" Foreground="#FF556070" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== 班级课表（扁平节次行 × 天列） ===== -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsClassViewMode, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!-- 拖拽引导提示 -->
                            <Border Background="#FFF0F5FF" Padding="8,4">
                                <TextBlock Text="提示：如需调整课程位置，请切换到年级总表进行拖动" FontSize="12" Foreground="#FF556070" />
                            </Border>

                            <Border Grid.Row="1" Background="#FFF0F5FF" BorderBrush="#FFD9E1EC" BorderThickness="1,1,1,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4">
                                        <TextBlock Text="节次" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding DayTabs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="Auto" MinWidth="100" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4"
                                                    Background="#FFF0F5FF">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <ItemsControl Grid.Row="2" ItemsSource="{Binding MatrixRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFD9E1EC" BorderThickness="1,0,1,1" Background="#FFFAFBFC">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#FFF0F5FF" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,0" Padding="4">
                                                    <TextBlock Text="{Binding PeriodLabel}" FontSize="12"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="Auto" MinWidth="100" MinHeight="36" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,0" Padding="4">
                                                                <Grid>
                                                                    <Border Background="#FFF5F5F5"
                                                                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                                                    <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="NoWrap"
                                                                               Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                                                                        <Run Text="{Binding Subject}" FontSize="18" />
                                                                        <Run Text=" " />
                                                                        <Run Text="{Binding TeacherName}" Foreground="#FF556070" />
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===== 教师课表（扁平节次行 × 天列，单元格显示班级） ===== -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsTeacherViewMode, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="#FFF0F5FF" BorderBrush="#FFD9E1EC" BorderThickness="1,1,1,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4">
                                        <TextBlock Text="节次" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding DayTabs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="120" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4"
                                                    Background="#FFF0F5FF">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding MatrixRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFD9E1EC" BorderThickness="1,0,1,1" Background="#FFFAFBFC">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#FFF0F5FF" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,0" Padding="4">
                                                    <TextBlock Text="{Binding PeriodLabel}" FontSize="12"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="120" MinHeight="36" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,0" Padding="4">
                                                                <Grid>
                                                                    <Border Background="#FFF5F5F5"
                                                                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                                                    <TextBlock VerticalAlignment="Center" FontSize="14" TextWrapping="NoWrap"
                                                                               Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                                                                        <Run Text="{Binding DisplayText}" FontSize="16" />
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== 导出页 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ExportPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="导出" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="导出课表到 Excel 文件。" Foreground="#FF5A6877" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="导出操作" FontWeight="SemiBold" />
                                <TextBlock Text="导出内容：年级课表.xlsx、班级课表.xlsx、教师课表.xlsx" FontSize="12" Foreground="#FF5A6877" TextWrapping="Wrap" />
                                <Button Content="📤 导出课表" Command="{Binding ExportCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF0066CC" FontWeight="Bold" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="输出位置" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ExportFolderPath}" TextWrapping="Wrap" Foreground="#FF5A6877" FontSize="12" />
                                <Button Content="📂 更改输出位置" Command="{Binding SelectExportFolderCommand}"
                                        Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF0066CC" FontWeight="Bold" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="操作记录" FontWeight="SemiBold" />
                                <ListBox ItemsSource="{Binding ActivityLog}" MaxHeight="250" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- *********************************************** -->
            <!-- RIGHT: 信息面板 -->
            <!-- *********************************************** -->
            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 当前选中信息 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="详情" FontSize="16" Foreground="#FF214E78" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,6" />
                        <TextBlock Text="当前选中" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.Subject}" Margin="0,2,0,0" FontSize="12" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.TeacherName}" FontSize="12" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.ClassName}" FontSize="12" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.SlotLabel}" FontSize="12" />
                    </StackPanel>

                    <!-- 信息提示（占满剩余空间） -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="信息" FontWeight="SemiBold" FontSize="14" Foreground="#FF214E78" VerticalAlignment="Center" />
                                <Border Background="#FFF0F5FF" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalConflicts}" FontSize="11" Foreground="#FF214E78" />
                                </Border>
                            </StackPanel>
                            <Button Content="清除" Command="{Binding ClearConflictsCommand}" HorizontalAlignment="Right"
                                    FontSize="11" Padding="8,2" Background="Transparent" BorderThickness="0" Foreground="#FF5A6877" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Conflicts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="6" Background="#FFF8F9FB"
                                                BorderBrush="#FFE0E6EF" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <Border CornerRadius="3" Padding="4,1" Margin="0,0,6,0" Background="#FFE3F2FD">
                                                        <TextBlock Text="{Binding SeverityText}" FontSize="11" Foreground="#FF1565C0" />
                                                    </Border>
                                                    <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="#FF5A6877" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Target}" FontSize="11" Foreground="#FF214E78"
                                                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#FF333333"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <!-- ========== 首页（无项目时显示） ========== -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Margin="0,50,0,0"
              Visibility="{Binding HasActiveProject, Converter={StaticResource InverseBoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <TextBlock Text="ACS" FontSize="48" FontWeight="Light" Foreground="#FF214E78"
                           HorizontalAlignment="Center" Margin="0,0,0,32" />
                <TextBlock Text="最近项目" FontSize="14" Foreground="#FF5A6877" Margin="0,0,0,8"
                           HorizontalAlignment="Center" />
                <ListView ItemsSource="{Binding HomePageProjects}" Height="400"
                          SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="RecentProject_Click"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          BorderBrush="#FFE0E6EF" BorderThickness="1" CornerRadius="8"
                          ItemTemplate="{StaticResource RecentProjectItemTemplate}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="新建项目" Style="{StaticResource TopButtonStyle}" Click="NewProject_Click"
                            MinWidth="100" Height="36" />
                    <Button Content="打开项目" Style="{StaticResource TopButtonStyle}" Click="OpenProject_Click"
                            MinWidth="100" Height="36" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== 排课进度弹窗 ===== -->
        <ContentDialog x:Name="ScheduleProgressDialog"
                       Title="{Binding DialogTitle}"
                       PrimaryButtonText="取消"
                       IsPrimaryButtonEnabled="{Binding DialogIsRunning}"
                       CloseButtonText="确认"
                       DefaultButton="Primary"
                       Style="{StaticResource DefaultContentDialogStyle}">
            <StackPanel Spacing="12" MinWidth="320">
                <TextBlock Text="{Binding DialogProgressText}" FontSize="14" />
                <ProgressBar Value="{Binding DialogProgress}" Minimum="0" Maximum="1" Height="6" />
                <TextBlock Text="排课完成！点击确认关闭。" FontSize="13" Foreground="Green"
                           Visibility="{Binding DialogIsComplete, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>