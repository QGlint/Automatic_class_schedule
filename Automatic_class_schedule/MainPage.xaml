<Page x:Class="Automatic_class_schedule.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="TopButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="TagButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFD9E1EC" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style TargetType="controls:DataGrid">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <DataTemplate x:Key="ScheduleEntryTemplate">
            <Border Margin="0,0,0,6"
                    Padding="6,4"
                    Background="#FFF8FBFF"
                    BorderBrush="#FFBFD7EE"
                    BorderThickness="1"
                    CornerRadius="6"
                    CanDrag="True"
                    AllowDrop="True"
                    DragStarting="Entry_DragStarting"
                    DragOver="Entry_DragOver"
                    Drop="Entry_Drop">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Subject}" FontSize="16" />
                        <TextBlock Text=" · " FontSize="16" />
                        <TextBlock Text="{Binding TeacherName}" FontSize="14" Foreground="#FF556070" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ClassName}"
                               FontSize="14"
                               Foreground="#FF1F4E79"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SchedulePeriodTemplate">
            <Border Margin="0,0,0,8" Padding="8" Background="White" BorderBrush="#FFD8E3F0" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#FFEAF2FF" CornerRadius="6" Padding="6" Margin="0,0,8,0">
                        <TextBlock Text="{Binding PeriodLabel}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource ScheduleEntryTemplate}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ScheduleDayTemplate">
            <Border Width="280" Margin="0,0,12,0" Padding="10" Background="White" BorderBrush="#FFD9E1EC" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#FFF0F5FF" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <TextBlock Text="{Binding DayName}" FontSize="18" Foreground="#FF214E78" HorizontalAlignment="Center" />
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource SchedulePeriodTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="12" Background="#FFF3F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="12" BorderBrush="#FFD9E1EC" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Content="配置" Command="{Binding SelectMainPageCommand}" CommandParameter="配置" Style="{StaticResource TopButtonStyle}" />
                    <Button Content="课表" Command="{Binding SelectMainPageCommand}" CommandParameter="课表" Style="{StaticResource TopButtonStyle}" />
                    <Button Content="导出" Command="{Binding SelectMainPageCommand}" CommandParameter="导出" Style="{StaticResource TopButtonStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#FF5A6877" Text="{Binding StatusMessage}" TextAlignment="Right" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- LEFT - Config Navigation -->
            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ConfigPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="配置导航" FontSize="18" Foreground="#FF214E78" Margin="0,0,0,8" />
                        <Button Content="加载示例" Command="{Binding SeedSampleDataCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="生成班级" Command="{Binding GenerateClassesCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="生成需求" Command="{Binding GenerateRequirementsCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="自动排课" Command="{Binding AutoScheduleCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="检查冲突" Command="{Binding ValidateCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="保存配置" Command="{Binding SaveCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="载入配置" Command="{Binding LoadCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,8,0,12" />
                        <TextBlock Text="配置页说明" Margin="0,0,0,8" />
                        <TextBlock Text="在右侧编辑班级、课程、需求和固定课程。" TextWrapping="Wrap" Foreground="#FF5A6877" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- LEFT - Schedule Navigation -->
            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding SchedulePageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="课表导航" FontSize="18" Foreground="#FF214E78" Margin="0,0,0,8" />
                        <Button Content="年级总表" Command="{Binding SelectViewModeCommand}" CommandParameter="年级总表" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="班级课表" Command="{Binding SelectViewModeCommand}" CommandParameter="班级课表" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="教师课表" Command="{Binding SelectViewModeCommand}" CommandParameter="教师课表" Style="{StaticResource NavButtonStyle}" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,8,0,12" />
                        <TextBlock Text="年级" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding GradeInputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding GradeName}" Click="GradeButton_Click" Style="{StaticResource TagButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="班级" Margin="0,10,0,8" />
                        <ItemsControl ItemsSource="{Binding Classes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding DisplayName}" Click="ClassButton_Click" Style="{StaticResource TagButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="教师" Margin="0,10,0,8" />
                        <ItemsControl ItemsSource="{Binding Teachers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Click="TeacherButton_Click" Style="{StaticResource TagButtonStyle}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,8,0,12" />
                        <Button Content="5天制" Command="{Binding UseFiveDayCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="7天制" Command="{Binding UseSevenDayCommand}" Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- LEFT - Export Navigation -->
            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ExportPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="导出导航" FontSize="18" Foreground="#FF214E78" Margin="0,0,0,8" />
                        <Button Content="导出课表" Command="{Binding ExportCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="导入数据" Click="ImportButton_Click" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="保存数据" Command="{Binding SaveCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,8,0,12" />
                        <TextBlock Text="输出目录" />
                        <TextBlock Text="{Binding ExportFolderPath}" TextWrapping="Wrap" Foreground="#FF5A6877" Margin="0,0,0,8" />
                        <TextBlock Text="本地数据文件" />
                        <TextBlock Text="{Binding DataFilePath}" TextWrapping="Wrap" Foreground="#FF5A6877" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER - Config Page -->
            <Border Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ConfigPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="配置界面" FontSize="20" Foreground="#FF214E78" />
                        <TextBlock Text="班级、课程、需求三块集中配置。" Foreground="#FF5A6877" Margin="0,0,0,12" />

                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="配置班级" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="年级配置" />
                                    <TextBlock Grid.Column="1" Text="班级会自动生成到右侧课表。" Foreground="#FF5A6877" HorizontalAlignment="Right" />
                                </Grid>
                                <controls:DataGrid ItemsSource="{Binding GradeInputs}" SelectedItem="{Binding SelectedGradeInput, Mode=TwoWay}">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="年级" Binding="{Binding GradeName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="班级数" Binding="{Binding ClassCount, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="配置课程" />
                                <TextBlock Text="直接编辑课程字典，后续生成需求会引用这些课程。" Foreground="#FF5A6877" />
                                <controls:DataGrid ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject, Mode=TwoWay}">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="课程" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="类别" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="配置需求" />
                                <TextBlock Text="生成班级之后，再生成授课需求。" Foreground="#FF5A6877" />
                                <controls:DataGrid ItemsSource="{Binding Requirements}" SelectedItem="{Binding SelectedRequirement, Mode=TwoWay}">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="班级" Binding="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                        <controls:DataGridTextColumn Header="教师" Binding="{Binding TeacherName, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                        <controls:DataGridTextColumn Header="课程" Binding="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                        <controls:DataGridTextColumn Header="周课时" Binding="{Binding WeeklyCount, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                        <controls:DataGridTextColumn Header="分布" Binding="{Binding DistributionRule, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                        <controls:DataGridCheckBoxColumn Header="上午优先" Binding="{Binding PreferMorning, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                        <controls:DataGridCheckBoxColumn Header="避开最后节" Binding="{Binding AvoidLastPeriod, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="固定课程" />
                                <TextBlock Text="全校、年级、班级或教师级别固定课。" Foreground="#FF5A6877" />
                                <controls:DataGrid ItemsSource="{Binding FixedLessons}" SelectedItem="{Binding SelectedFixedLesson, Mode=TwoWay}">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="范围" Binding="{Binding ScopeValue, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                        <controls:DataGridTextColumn Header="星期" Binding="{Binding DayIndex, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <controls:DataGridTextColumn Header="节次" Binding="{Binding PeriodIndex, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <controls:DataGridTextColumn Header="课程" Binding="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                        <controls:DataGridTextColumn Header="原因" Binding="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CENTER - Schedule Page -->
            <Border Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding SchedulePageVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#FFF0F5FF" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SchoolName}" FontSize="20" Foreground="#FF214E78" />
                                <TextBlock Text="{Binding CurrentScopeSummary}" Foreground="#FF5A6877" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DaysPerWeek}" VerticalAlignment="Center" Foreground="#FF5A6877" FontSize="16" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TimetableDays}" ItemTemplate="{StaticResource ScheduleDayTemplate}" AllowDrop="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- CENTER - Export Page -->
            <Border Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ExportPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="导出界面" FontSize="20" Foreground="#FF214E78" />
                        <TextBlock Text="导入、导出、保存都放在这里。" Foreground="#FF5A6877" Margin="0,0,0,12" />
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="导出操作" />
                                <Button Content="导出课表" Command="{Binding ExportCommand}" Style="{StaticResource NavButtonStyle}" />
                                <Button Content="导入数据" Click="ImportButton_Click" Style="{StaticResource NavButtonStyle}" />
                                <Button Content="保存数据" Command="{Binding SaveCommand}" Style="{StaticResource NavButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="输出目录" />
                                <TextBlock Text="{Binding ExportFolderPath}" TextWrapping="Wrap" Foreground="#FF5A6877" />
                                <TextBlock Text="本地数据文件" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding DataFilePath}" TextWrapping="Wrap" Foreground="#FF5A6877" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT - Config Details -->
            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ConfigPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="配置详情" FontSize="18" Foreground="#FF214E78" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,8,0,10" />
                        <TextBlock Text="当前年级" />
                        <TextBlock Text="{Binding SelectedGradeInput.GradeName}" />
                        <TextBlock Text="当前班级" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding SelectedClass.DisplayName}" />
                        <TextBlock Text="当前教师" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding SelectedTeacher.Name}" />
                        <TextBlock Text="当前课程" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding SelectedSubject.Name}" />
                        <TextBlock Text="{Binding SelectedSubject.Category}" />
                        <TextBlock Text="当前需求" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding SelectedRequirement.Subject}" />
                        <TextBlock Text="{Binding SelectedRequirement.ClassName}" />
                        <TextBlock Text="{Binding SelectedRequirement.TeacherName}" />
                        <TextBlock Text="当前固定课" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding SelectedFixedLesson.Subject}" />
                        <TextBlock Text="{Binding SelectedFixedLesson.ScopeValue}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT - Schedule Details -->
            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding SchedulePageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="课表详情" FontSize="18" Foreground="#FF214E78" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,8,0,10" />
                        <TextBlock Text="当前选中课程" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.Subject}" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.TeacherName}" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.ClassName}" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.SlotLabel}" Margin="0,0,0,8" />
                        <TextBlock Text="当前冲突" />
                        <TextBlock Text="{Binding Conflicts.Count}" />
                        <Border Style="{StaticResource SectionBorderStyle}" Margin="0,10,0,0">
                            <controls:DataGrid ItemsSource="{Binding Conflicts}" IsReadOnly="True" AutoGenerateColumns="False">
                                <controls:DataGrid.Columns>
                                    <controls:DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="70" />
                                    <controls:DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="120" />
                                    <controls:DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="*" />
                                </controls:DataGrid.Columns>
                            </controls:DataGrid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT - Export Details -->
            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ExportPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="导出详情" FontSize="18" Foreground="#FF214E78" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,8,0,10" />
                        <TextBlock Text="当前状态" />
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                        <TextBlock Text="输出路径" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding ExportFolderPath}" TextWrapping="Wrap" />
                        <TextBlock Text="操作记录" Margin="0,10,0,0" />
                        <ListBox ItemsSource="{Binding ActivityLog}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
