<Page x:Class="Automatic_class_schedule.MainPage"
      x:Name="SchedulePageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
      xmlns:infra="using:Automatic_class_schedule.Infrastructure"
      mc:Ignorable="d">

    <Page.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <infra:StringMatchToVisibilityConverter x:Key="StringMatchToVisibility" />

        <Style x:Key="RoundButtonBase" TargetType="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="TopButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonBase}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#FFF0F5FF" />
            <Setter Property="Foreground" Value="#FF214E78" />
        </Style>

        <Style x:Key="TopActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource TopButtonStyle}">
            <Setter Property="Background" Value="#FF214E78" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonBase}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#FFF0F5FF" />
            <Setter Property="Foreground" Value="#FF214E78" />
        </Style>

        <Style x:Key="NavActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#FF214E78" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="TagButtonStyle" TargetType="Button" BasedOn="{StaticResource RoundButtonBase}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#FFF5F5F5" />
            <Setter Property="Foreground" Value="#FF214E78" />
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFD9E1EC" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style TargetType="controls:DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <DataTemplate x:Key="ScheduleEntryTemplate">
            <Border Margin="0,0,0,2" Padding="3,2"
                    Background="#FFF8FBFF" BorderBrush="#FFBFD7EE"
                    BorderThickness="1" CornerRadius="3"
                    CanDrag="True" AllowDrop="True"
                    DragStarting="Entry_DragStarting"
                    DragOver="Entry_DragOver" Drop="Entry_Drop">
                <TextBlock FontSize="11" TextWrapping="NoWrap">
                    <Run Text="{Binding ClassName}" Foreground="#FF7A8BA8" />
                    <Run Text=" " />
                    <Run Text="{Binding Subject}" />
                    <Run Text=" " />
                    <Run Text="{Binding TeacherName}" Foreground="#FF556070" />
                </TextBlock>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="8" Background="#FFF3F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========== 可折叠顶部工具栏 ========== -->
        <Border Background="#FFFAFBFC" CornerRadius="8" BorderBrush="#FFE0E6EF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 折叠切换行 -->
                <Grid Padding="6,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="新建项目" Command="{Binding NewProjectCommand}" Style="{StaticResource TopButtonStyle}" />
                        <Button Content="打开项目" x:Name="OpenProjectButton" Click="OpenProject_Click" Style="{StaticResource TopButtonStyle}" />
                        <Button Content="保存项目" x:Name="SaveProjectButton" Click="SaveProject_Click" Style="{StaticResource TopButtonStyle}" />
                        <TextBlock Text="{Binding ProjectFileName}" FontSize="12" Foreground="#FF5A6877" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Content="加载示例" Command="{Binding SeedSampleDataCommand}" Style="{StaticResource TopButtonStyle}" Margin="12,0,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ToggleToolbarCommand}" Style="{StaticResource TopButtonStyle}" MinWidth="28" Padding="4,2">
                        <TextBlock x:Name="ToolbarToggleIcon" Text="▲" FontSize="10" />
                    </Button>
                </Grid>
                <!-- 工具栏扩展区域 -->
                <Border Grid.Row="1" BorderBrush="#FFE0E6EF" BorderThickness="0,1,0,0" Padding="6,4"
                        Visibility="{Binding IsToolbarExpanded, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SchoolName}" FontSize="12" FontWeight="SemiBold" Foreground="#FF214E78" VerticalAlignment="Center" Margin="8,0,6,0" />
                            <TextBlock Text="|" Foreground="#FFD9E1EC" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#FF5A6877" Margin="6,0" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ProgressBar Value="{Binding ProgressValue}" Maximum="1" Width="120" Margin="0,0,6,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========== 主导航栏（配置 / 课表 / 导出） ========== -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" BorderBrush="#FFD9E1EC" BorderThickness="1" Padding="0" Margin="0,6,0,0"
                Visibility="{Binding HasActiveProject, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="⚙ 配置" Command="{Binding SelectMainPageCommand}" CommandParameter="配置"
                        Height="48" FontSize="16" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="0"
                        Background="#FF214E78" Foreground="White"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=配置}" />
                <Button Content="⚙ 配置" Command="{Binding SelectMainPageCommand}" CommandParameter="配置"
                        Height="48" FontSize="16" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="0"
                        Background="#FFF0F5FF" Foreground="#FF214E78"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=配置}" />
                <Button Grid.Column="1" Content="📅 课表" Command="{Binding SelectMainPageCommand}" CommandParameter="课表"
                        Height="48" FontSize="16" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="0"
                        Background="#FF214E78" Foreground="White"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=课表}" />
                <Button Grid.Column="1" Content="📅 课表" Command="{Binding SelectMainPageCommand}" CommandParameter="课表"
                        Height="48" FontSize="16" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="0"
                        Background="#FFF0F5FF" Foreground="#FF214E78"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=课表}" />
                <Button Grid.Column="2" Content="📤 导出" Command="{Binding SelectMainPageCommand}" CommandParameter="导出"
                        Height="48" FontSize="16" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="0"
                        Background="#FF214E78" Foreground="White"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=导出}" />
                <Button Grid.Column="2" Content="📤 导出" Command="{Binding SelectMainPageCommand}" CommandParameter="导出"
                        Height="48" FontSize="16" FontWeight="SemiBold"
                        BorderThickness="0" CornerRadius="0"
                        Background="#FFF0F5FF" Foreground="#FF214E78"
                        Visibility="{Binding SelectedMainPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=导出}" />
            </Grid>
        </Border>

        <!-- ========== 主内容区域 ========== -->
        <Grid Grid.Row="2" Margin="0,8,0,0"
              Visibility="{Binding HasActiveProject, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <!-- *********************************************** -->
            <!-- LEFT NAVIGATIONS -->
            <!-- *********************************************** -->

            <!-- ===== 配置导航 ===== -->
            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ConfigPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="配置步骤" FontSize="16" Foreground="#FF214E78" Margin="0,0,0,8" />
                        <Button Content="1. 基础设置" Command="{Binding SelectConfigPageCommand}" CommandParameter="基础设置"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=基础设置}" />
                        <Button Content="1. 基础设置" Command="{Binding SelectConfigPageCommand}" CommandParameter="基础设置"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=基础设置}" />
                        <Button Content="2. 班级配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="班级配置"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=班级配置}" />
                        <Button Content="2. 班级配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="班级配置"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=班级配置}" />
                        <Button Content="3. 课程配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="课程配置"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=课程配置}" />
                        <Button Content="3. 课程配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="课程配置"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=课程配置}" />
                        <Button Content="4. 教师配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="教师配置"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=教师配置}" />
                        <Button Content="4. 教师配置" Command="{Binding SelectConfigPageCommand}" CommandParameter="教师配置"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=教师配置}" />
                        <Button Content="5. 固定课程" Command="{Binding SelectConfigPageCommand}" CommandParameter="固定课程"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=固定课程}" />
                        <Button Content="5. 固定课程" Command="{Binding SelectConfigPageCommand}" CommandParameter="固定课程"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=固定课程}" />
                        <Button Content="6. 自动排课" Command="{Binding SelectConfigPageCommand}" CommandParameter="自动排课"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=自动排课}" />
                        <Button Content="6. 自动排课" Command="{Binding SelectConfigPageCommand}" CommandParameter="自动排课"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedConfigPage, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=自动排课}" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,8" />
                        <Button Content="检查冲突" Command="{Binding ValidateCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="导入数据" Command="{Binding ImportCommand}" Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 课表导航 ===== -->
            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding SchedulePageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="课表导航" FontSize="16" Foreground="#FF214E78" Margin="0,0,0,6" />
                        <Button Content="年级总表" Command="{Binding SelectViewModeCommand}" CommandParameter="年级总表"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=年级总表}" />
                        <Button Content="年级总表" Command="{Binding SelectViewModeCommand}" CommandParameter="年级总表"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=年级总表}" />
                        <Button Content="班级课表" Command="{Binding SelectViewModeCommand}" CommandParameter="班级课表"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=班级课表}" />
                        <Button Content="班级课表" Command="{Binding SelectViewModeCommand}" CommandParameter="班级课表"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=班级课表}" />
                        <Button Content="教师课表" Command="{Binding SelectViewModeCommand}" CommandParameter="教师课表"
                                Style="{StaticResource NavButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource InverseBoolToVisibility}, ConverterParameter=教师课表}" />
                        <Button Content="教师课表" Command="{Binding SelectViewModeCommand}" CommandParameter="教师课表"
                                Style="{StaticResource NavActiveButtonStyle}"
                                Visibility="{Binding SelectedViewMode, Converter={StaticResource StringMatchToVisibility}, ConverterParameter=教师课表}" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,10" />

                        <StackPanel Visibility="{Binding IsTeacherViewMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBox PlaceholderText="搜索教师..." Text="{Binding TeacherSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Padding="6,4" />
                            <TextBlock Text="教师" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding FilteredTeachers}" MaxHeight="160">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Name}" Click="TeacherButton_Click" Style="{StaticResource TagButtonStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsGradeViewMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBox PlaceholderText="筛选年级..." Text="{Binding GradeFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" Padding="6,4" />
                            <TextBlock Text="年级" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding FilteredGrades}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding GradeName}" Click="GradeButton_Click" Style="{StaticResource TagButtonStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsClassViewMode, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="班级" FontWeight="SemiBold" Margin="0,8,0,6" />
                            <ItemsControl ItemsSource="{Binding FilteredClasses}" MaxHeight="160">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayName}" Click="ClassButton_Click" Style="{StaticResource TagButtonStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,10" />
                        <Button Content="5 天制" Command="{Binding UseFiveDayCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="7 天制" Command="{Binding UseSevenDayCommand}" Style="{StaticResource NavButtonStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 导出导航 ===== -->
            <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ExportPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="导出导航" FontSize="16" Foreground="#FF214E78" Margin="0,0,0,6" />
                        <Button Content="导出课表" Command="{Binding ExportCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="导入数据" Click="ImportButton_Click" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="保存数据" Command="{Binding SaveCommand}" Style="{StaticResource NavButtonStyle}" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,10" />
                        <TextBlock Text="输出目录" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExportFolderPath}" TextWrapping="Wrap" Foreground="#FF5A6877" Margin="0,0,0,6" FontSize="12" />
                        <TextBlock Text="本地数据文件" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DataFilePath}" TextWrapping="Wrap" Foreground="#FF5A6877" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- *********************************************** -->
            <!-- CENTER CONTENT -->
            <!-- *********************************************** -->

            <!-- ===== 基础设置 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsBasicSettingsVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="基础设置" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="配置学校基本信息和每天节次。" Foreground="#FF5A6877" Margin="0,0,0,12" />

                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="学校信息" FontWeight="SemiBold" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="学校名称" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding SchoolName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Padding="6,4" />
                                    <TextBlock Grid.Row="1" Text="每周天数" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedValue="{Binding DaysPerWeek}" Margin="0,0,0,6" Width="100" HorizontalAlignment="Left">
                                        <x:Int32>5</x:Int32>
                                        <x:Int32>6</x:Int32>
                                        <x:Int32>7</x:Int32>
                                    </ComboBox>
                                    <TextBlock Grid.Row="2" Text="上午节数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MorningPeriods, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="60" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="3" Text="下午节数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AfternoonPeriods, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="60" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Row="4" Text="晚自习" VerticalAlignment="Center" />
                                    <ToggleSwitch Grid.Row="4" Grid.Column="1" IsOn="{Binding IncludeEveningSelfStudy}" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="5" Text="晚自习节数" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding EveningPeriods, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" Width="60" HorizontalAlignment="Left"
                                             IsEnabled="{Binding IncludeEveningSelfStudy}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="提示：上午节数 + 下午节数 + 晚自习节数 = 每天总节数。" Foreground="#FF5A6877" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 班级配置 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsClassConfigVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="班级配置" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="确认年级和各年级班级数，系统自动生成班级。" Foreground="#FF5A6877" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <controls:DataGrid ItemsSource="{Binding GradeInputs}" SelectedItem="{Binding SelectedGradeInput, Mode=TwoWay}">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="年级" Binding="{Binding GradeName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="班级数" Binding="{Binding ClassCount, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="班级列表" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Classes}" Margin="0,6,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="3" Padding="8,5" Background="#FFF0F5FF" CornerRadius="5">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="#FF214E78" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 课程配置 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsSubjectConfigVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="课程配置" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="配置课程名称、类别、每周课时和分布规则。" Foreground="#FF5A6877" Margin="0,0,0,10" />
                        <!-- 年级子标签 -->
                        <ItemsControl ItemsSource="{Binding GradeInputs}" Margin="0,0,0,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Button Content="{Binding GradeName}" Click="SubjectGradeTabButton_Click"
                                                Height="36" MinWidth="80" Margin="0,0,6,0" Padding="12,4"
                                                CornerRadius="6" FontSize="14" FontWeight="SemiBold"
                                                BorderThickness="0"
                                                Background="#FFF0F5FF" Foreground="#FF214E78" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="课程列表" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="添加" Command="{Binding AddSubjectCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" Margin="0,0,6,0" />
                                    <Button Grid.Column="2" Content="删除" Command="{Binding DeleteSubjectCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" />
                                </Grid>
                                <controls:DataGrid ItemsSource="{Binding FilteredSubjects}" SelectedItem="{Binding SelectedSubject, Mode=TwoWay}">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="年级" Binding="{Binding GradeName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="课程" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="类别" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="周课时" Binding="{Binding DefaultWeeklyCount, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTemplateColumn Header="分布规则" Width="*">
                                            <controls:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.DistributionRuleOptions, ElementName=SchedulePageRoot}"
                                                              SelectedItem="{Binding DistributionRule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              BorderThickness="0" MinHeight="28" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </controls:DataGridTemplateColumn.CellTemplate>
                                        </controls:DataGridTemplateColumn>
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 教师配置 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsTeacherConfigVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="教师配置" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="配置教师授课安排：教师 + 科目 + 所带班级。" Foreground="#FF5A6877" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="每行配置一个教师，可带多个班级（用、分隔）。" Foreground="#FF5A6877" VerticalAlignment="Center" FontSize="13" />
                                    <Button Grid.Column="1" Content="生成需求" Command="{Binding GenerateRequirementsCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" Margin="10,0,0,0" />
                                </Grid>
                                <controls:DataGrid ItemsSource="{Binding TeacherAssignments}" SelectedItem="{Binding SelectedTeacherAssignment, Mode=TwoWay}">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="教师" Binding="{Binding TeacherName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="科目" Binding="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="周课时" Binding="{Binding WeeklyCount, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="从课程生成教师示例" Command="{Binding GenerateAssignmentsCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" Margin="0,0,8,0" />
                            <Button Content="导入教师数据" Click="ImportTeacherData_Click" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 固定课程 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsFixedLessonConfigVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="固定课程" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="配置全校、年级、班级或教师级别的固定课程。" Foreground="#FF5A6877" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="固定课程列表" FontWeight="SemiBold" />
                                <controls:DataGrid ItemsSource="{Binding FixedLessons}" SelectedItem="{Binding SelectedFixedLesson, Mode=TwoWay}">
                                    <controls:DataGrid.Columns>
                                        <controls:DataGridTextColumn Header="范围" Binding="{Binding ScopeValue, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="星期" Binding="{Binding DayIndex, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="节次" Binding="{Binding PeriodIndex, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="课程" Binding="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <controls:DataGridTextColumn Header="原因" Binding="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    </controls:DataGrid.Columns>
                                </controls:DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 自动排课 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding IsAutoScheduleVisible, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="自动排课" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="确认所有配置后点击下方按钮生成课表。" Foreground="#FF5A6877" Margin="0,0,0,12" />

                        <Border Background="#FFF0F5FF" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="配置概览" FontSize="16" Foreground="#FF214E78" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="学校" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Column="1" Text="{Binding SchoolName}" Margin="10,0" />
                                    <TextBlock Grid.Row="1" Text="班级数" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalClasses}" Margin="10,0" />
                                    <TextBlock Grid.Row="2" Text="课程数" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalSubjects}" Margin="10,0" />
                                    <TextBlock Grid.Row="3" Text="教师安排" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalAssignments}" Margin="10,0" />
                                    <TextBlock Grid.Row="4" Text="授课需求" Foreground="#FF5A6877" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalRequirements}" Margin="10,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Value="{Binding ProgressValue}" Maximum="1" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Grid.Column="1" Content="开始排课" Command="{Binding AutoScheduleCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" MinWidth="100" />
                            <Button Grid.Column="2" Content="取消" Command="{Binding CancelCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" Margin="6,0,0,0" />
                        </Grid>

                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,12" />
                        <Button Content="检查冲突" Command="{Binding ValidateCommand}" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" HorizontalAlignment="Left" />
                        <controls:DataGrid ItemsSource="{Binding Conflicts}" IsReadOnly="True" Margin="0,6,0,0" MaxHeight="180">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="60" />
                                <controls:DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80" />
                                <controls:DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="*" />
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>

                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,10" />
                        <TextBlock Text="操作记录" FontWeight="SemiBold" />
                        <ListBox ItemsSource="{Binding ActivityLog}" MaxHeight="120" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== 课表视图 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding SchedulePageVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#FFF0F5FF" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SchoolName}" FontSize="18" Foreground="#FF214E78" />
                                <TextBlock Text="{Binding CurrentScopeSummary}" Foreground="#FF5A6877" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TotalScheduleEntries}" VerticalAlignment="Center" Foreground="#FF5A6877" />
                        </Grid>
                    </Border>

                    <!-- 年级子标签 -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding GradeInputs}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Button Content="{Binding GradeName}" Click="GradeTabButton_Click"
                                            Height="36" MinWidth="80" Margin="0,0,6,0" Padding="12,4"
                                            CornerRadius="6" FontSize="14" FontWeight="SemiBold"
                                            BorderThickness="0"
                                            Background="#FFF0F5FF" Foreground="#FF214E78" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ===== 年级总表（合并节次标签 + 班级行 + 天列） ===== -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsGradeViewMode, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 表头行 -->
                            <Border Background="#FFF0F5FF" BorderBrush="#FFD9E1EC" BorderThickness="1,1,1,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4">
                                        <TextBlock Text="节次" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Column="1" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4">
                                        <TextBlock Text="班级" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding DayTabs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="Auto" MinWidth="100" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4"
                                                    Background="#FFF0F5FF">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <!-- 数据行：PeriodGroup 分组 -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding GradePeriodGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFD9E1EC" BorderThickness="1,0,1,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 合并的节次标签，自动撑满全高 -->
                                                <Border Background="#FFF0F5FF" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4">
                                                    <TextBlock Text="{Binding PeriodLabel}" FontSize="12"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <!-- 班级子行 -->
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding ClassRows}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#FFD9E1EC" BorderThickness="0,0,0,1" Background="#FFFAFBFC">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="80" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <!-- 班级名称 -->
                                                                    <Border BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,0" Padding="4">
                                                                        <TextBlock Text="{Binding ClassName}" FontSize="12"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <!-- 天列 -->
                                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Width="Auto" MinWidth="100" MinHeight="36" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,0" Padding="4"
                                                                                CanDrag="True" AllowDrop="True"
                                                                                DragStarting="GridCell_DragStarting"
                                                                                DragOver="GridCell_DragOver"
                                                                                Drop="GridCell_Drop">
                                                                                    <Grid>
                                                                                        <Border Background="#FFF5F5F5"
                                                                                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                                                                        <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="NoWrap"
                                                                                                   Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                                                                                            <Run Text="{Binding Subject}" />
                                                                                            <Run Text=" " />
                                                                                            <Run Text="{Binding TeacherName}" Foreground="#FF556070" />
                                                                                        </TextBlock>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===== 班级课表（扁平节次行 × 天列） ===== -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsClassViewMode, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="#FFF0F5FF" BorderBrush="#FFD9E1EC" BorderThickness="1,1,1,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4">
                                        <TextBlock Text="节次" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding DayTabs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="Auto" MinWidth="100" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4"
                                                    Background="#FFF0F5FF">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding MatrixRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFD9E1EC" BorderThickness="1,0,1,1" Background="#FFFAFBFC">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#FFF0F5FF" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,0" Padding="4">
                                                    <TextBlock Text="{Binding PeriodLabel}" FontSize="12"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="Auto" MinWidth="100" MinHeight="36" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,0" Padding="4"
                                                            CanDrag="True" AllowDrop="True"
                                                            DragStarting="GridCell_DragStarting"
                                                            DragOver="GridCell_DragOver"
                                                            Drop="GridCell_Drop">
                                                                <Grid>
                                                                    <Border Background="#FFF5F5F5"
                                                                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                                                    <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="NoWrap"
                                                                               Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                                                                        <Run Text="{Binding Subject}" />
                                                                        <Run Text=" " />
                                                                        <Run Text="{Binding TeacherName}" Foreground="#FF556070" />
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>

                    <!-- ===== 教师课表（扁平节次行 × 天列，单元格显示班级） ===== -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsTeacherViewMode, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Background="#FFF0F5FF" BorderBrush="#FFD9E1EC" BorderThickness="1,1,1,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4">
                                        <TextBlock Text="节次" FontSize="12" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding DayTabs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="Auto" MinWidth="100" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,1" Padding="4"
                                                    Background="#FFF0F5FF">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding MatrixRows}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#FFD9E1EC" BorderThickness="1,0,1,1" Background="#FFFAFBFC">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#FFF0F5FF" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,0" Padding="4">
                                                    <TextBlock Text="{Binding PeriodLabel}" FontSize="12"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="Auto" MinWidth="100" MinHeight="36" BorderBrush="#FFD9E1EC" BorderThickness="0,0,1,0" Padding="4"
                                                            CanDrag="True" AllowDrop="True"
                                                            DragStarting="GridCell_DragStarting"
                                                            DragOver="GridCell_DragOver"
                                                            Drop="GridCell_Drop">
                                                                <Grid>
                                                                    <Border Background="#FFF5F5F5"
                                                                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                                                                    <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="NoWrap"
                                                                               Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
                                                                        <Run Text="{Binding Subject}" />
                                                                        <Run Text=" " />
                                                                        <Run Text="{Binding ClassName}" Foreground="#FF556070" />
                                                                    </TextBlock>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===== 导出页 ===== -->
            <Border Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource SectionBorderStyle}"
                    Visibility="{Binding ExportPageVisibility}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="导出" FontSize="18" Foreground="#FF214E78" />
                        <TextBlock Text="导出课表到 Excel 文件。" Foreground="#FF5A6877" Margin="0,0,0,10" />
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="导出操作" FontWeight="SemiBold" />
                                <Button Content="导出课表" Command="{Binding ExportCommand}" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="输出目录" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ExportFolderPath}" TextWrapping="Wrap" Foreground="#FF5A6877" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="操作记录" FontWeight="SemiBold" />
                                <ListBox ItemsSource="{Binding ActivityLog}" MaxHeight="250" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- *********************************************** -->
            <!-- RIGHT: Detail Panel -->
            <!-- *********************************************** -->
            <Border Grid.Column="2" Style="{StaticResource SectionBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="详情" FontSize="16" Foreground="#FF214E78" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,8" />
                        <TextBlock Text="当前选中" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.Subject}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.TeacherName}" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.ClassName}" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.SlotLabel}" Margin="0,0,0,6" />
                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,6,0,8" />
                        <TextBlock Text="冲突提示" FontWeight="SemiBold" />
                        <controls:DataGrid ItemsSource="{Binding Conflicts}" IsReadOnly="True" MaxHeight="180">
                            <controls:DataGrid.Columns>
                                <controls:DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="*" />
                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ========== 欢迎 / 新建项目 覆盖层 ========== -->
        <Border Grid.RowSpan="3" Background="#FFF3F5F9"
                Visibility="{Binding HasActiveProject, Converter={StaticResource InverseBoolToVisibility}}">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <Border Background="White" CornerRadius="12" BorderBrush="#FFD9E1EC" BorderThickness="1" Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock Text="自动排课系统" FontSize="22" FontWeight="Bold" Foreground="#FF214E78" HorizontalAlignment="Center" />
                        <TextBlock Text="欢迎使用自动排课系统，请创建或打开一个项目。" Foreground="#FF5A6877" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />

                        <Rectangle Height="1" Fill="#FFD9E1EC" Margin="0,4" />

                        <TextBlock Text="项目名称" FontWeight="SemiBold" />
                        <TextBox x:Name="ProjectNameTextBox" Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例如: 2024年上学期" Padding="8,6" />

                        <TextBlock Text="存储位置" FontWeight="SemiBold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ProjectFilePath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="默认: Documents\asc\项目名称.ascproj" Padding="8,6" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="浏览..." x:Name="BrowseLocationButton" Click="BrowseLocation_Click" Margin="6,0,0,0" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0">
                            <Button Content="创建项目" x:Name="WelcomeCreateButton" Click="CreateProject_Click" Style="{StaticResource RoundButtonBase}" Background="#FF214E78" Foreground="White" MinWidth="120" FontSize="15" />
                            <Button Content="打开项目" x:Name="WelcomeOpenButton" Click="OpenProject_Click" Style="{StaticResource RoundButtonBase}" Background="#FFF0F5FF" Foreground="#FF214E78" MinWidth="120" FontSize="15" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#FFD32F2F" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>