<Window x:Class="Automatic_class_schedule.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Automatic_class_schedule.ViewModels"
        mc:Ignorable="d"
        Title="自动排课系统"
        Height="900"
        Width="1600"
        MinHeight="760"
        MinWidth="1280"
        WindowState="Maximized"
        Background="#FFF3F5F9">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="MinWidth" Value="86" />
        </Style>

        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="SectionGroupStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FFD9E1EC" />
        </Style>

        <Style x:Key="ModeVisibleGroupStyle" TargetType="GroupBox" BasedOn="{StaticResource SectionGroupStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <DataTemplate DataType="{x:Type vm:ScheduleRowViewModel}">
            <Border Margin="0,0,10,0" Padding="8" Background="White" BorderBrush="#FFD9E1EC" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFF0F5FF" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                        <TextBlock Text="{Binding DayName}" FontSize="16" FontWeight="Bold" Foreground="#FF214E78" HorizontalAlignment="Center" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ScheduleCellViewModel}">
                                <Border Margin="0,0,0,6" Padding="6" Background="#FFFAFCFF" BorderBrush="#FFD8E3F0" BorderThickness="1" CornerRadius="6" AllowDrop="True" Drop="PeriodBlock_Drop">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#FFEAF2FF" CornerRadius="4" Padding="4" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding PeriodLabel}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,4"
                                                            Padding="5,2"
                                                            Background="#FFF8FBFF"
                                                            BorderBrush="#FFBFD7EE"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            AllowDrop="True"
                                                            Drop="LessonCard_Drop"
                                                            PreviewMouseMove="LessonCard_MouseMove">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text=" · " />
                                                                <TextBlock Text="{Binding TeacherName}" FontSize="11" Foreground="#FF556070" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding ClassName}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#FF1F4E79"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="10,0,0,0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="White" CornerRadius="10" BorderBrush="#FFD9E1EC" BorderThickness="1" Padding="10">
            <WrapPanel>
                <Button Content="加载示例" Command="{Binding SeedSampleDataCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="生成班级" Command="{Binding GenerateClassesCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="生成需求" Command="{Binding GenerateRequirementsCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="自动排课" Command="{Binding AutoScheduleCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="检查冲突" Command="{Binding ValidateCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="保存" Command="{Binding SaveCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="导入" Command="{Binding ImportCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="导出" Command="{Binding ExportCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Separator Width="14" Opacity="0" />
                <Button Content="5天" Command="{Binding UseFiveDayCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <Button Content="7天" Command="{Binding UseSevenDayCommand}" Style="{StaticResource ToolbarButtonStyle}" />
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF5A6877" Text="{Binding StatusMessage}" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="10" BorderBrush="#FFD9E1EC" BorderThickness="1" Padding="10" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox Header="视图切换" Style="{StaticResource SectionGroupStyle}">
                            <StackPanel Margin="10">
                                <Button Content="年级总表" Command="{Binding SelectViewModeCommand}" CommandParameter="年级总表" Style="{StaticResource ModeButtonStyle}" />
                                <Button Content="班级课表" Command="{Binding SelectViewModeCommand}" CommandParameter="班级课表" Style="{StaticResource ModeButtonStyle}" />
                                <Button Content="教师课表" Command="{Binding SelectViewModeCommand}" CommandParameter="教师课表" Style="{StaticResource ModeButtonStyle}" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="年级选择">
                            <GroupBox.Style>
                                <Style TargetType="GroupBox" BasedOn="{StaticResource ModeVisibleGroupStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedViewMode}" Value="年级总表">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>
                            <ScrollViewer Margin="10" Height="180" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GradeInputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding GradeName}"
                                                    Command="{Binding DataContext.SelectGradeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ChipButtonStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>

                        <GroupBox Header="班级选择">
                            <GroupBox.Style>
                                <Style TargetType="GroupBox" BasedOn="{StaticResource ModeVisibleGroupStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedViewMode}" Value="班级课表">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>
                            <ScrollViewer Margin="10" Height="220" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Classes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding DisplayName}"
                                                    Command="{Binding DataContext.SelectClassCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ChipButtonStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>

                        <GroupBox Header="教师选择">
                            <GroupBox.Style>
                                <Style TargetType="GroupBox" BasedOn="{StaticResource ModeVisibleGroupStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedViewMode}" Value="教师课表">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </GroupBox.Style>
                            <ScrollViewer Margin="10" Height="220" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Teachers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}"
                                                    Command="{Binding DataContext.SelectTeacherCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ChipButtonStyle}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>

                        <GroupBox Header="排课范围" Style="{StaticResource SectionGroupStyle}">
                            <StackPanel Margin="10">
                                <TextBlock Text="当前范围" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurrentScopeSummary}" Margin="0,0,0,8" />
                                <TextBlock Text="每周天数" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DaysPerWeek}" Margin="0,0,0,8" />
                                <TextBlock Text="每天节数" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PeriodsPerDay}" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#FFD9E1EC" BorderThickness="1" Padding="10" Margin="0,0,12,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFF0F5FF" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SchoolName}" FontSize="18" FontWeight="Bold" Foreground="#FF214E78" />
                                <TextBlock Text="{Binding CurrentScopeSummary}" Foreground="#FF5A6877" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding DaysPerWeek}" VerticalAlignment="Center" Foreground="#FF5A6877" />
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TimetableDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding DataContext.DaysPerWeek, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ScheduleRowViewModel}">
                                    <Border Margin="0,0,10,0" Padding="8" Background="#FFFBFDFF" BorderBrush="#FFD9E1EC" BorderThickness="1" CornerRadius="8">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Top" Background="#FFF0F5FF" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding DayName}" FontSize="16" FontWeight="Bold" Foreground="#FF214E78" HorizontalAlignment="Center" />
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Cells}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ScheduleCellViewModel}">
                                                        <Border Margin="0,0,0,6" Padding="6" Background="White" BorderBrush="#FFD8E3F0" BorderThickness="1" CornerRadius="6" AllowDrop="True" Drop="PeriodBlock_Drop">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="56" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Background="#FFEAF2FF" CornerRadius="4" Padding="4" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding PeriodLabel}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Entries}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Margin="0,0,0,4"
                                                                                    Padding="5,2"
                                                                                    Background="#FFF8FBFF"
                                                                                    BorderBrush="#FFBFD7EE"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="4"
                                                                                    AllowDrop="True"
                                                                                    Drop="LessonCard_Drop"
                                                                                    PreviewMouseMove="LessonCard_MouseMove">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="*" />
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Text=" · " />
                                                                                        <TextBlock Text="{Binding TeacherName}" FontSize="11" Foreground="#FF556070" TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding ClassName}"
                                                                                               FontSize="11"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="#FF1F4E79"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               Margin="10,0,0,0" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10" BorderBrush="#FFD9E1EC" BorderThickness="1" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="详情 / 冲突" FontSize="16" FontWeight="Bold" Foreground="#FF214E78" />
                        <Separator Margin="0,8,0,8" />
                        <TextBlock Text="当前选中课程" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.Subject, TargetNullValue=无}" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.TeacherName, TargetNullValue=无}" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.ClassName, TargetNullValue=无}" />
                        <TextBlock Text="{Binding SelectedScheduleEntry.SlotLabel, TargetNullValue=无}" Margin="0,0,0,8" />

                        <TextBlock Text="当前冲突" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Conflicts.Count}" Margin="0,0,0,8" />

                        <GroupBox Header="冲突列表" Style="{StaticResource SectionGroupStyle}">
                            <DataGrid ItemsSource="{Binding Conflicts}" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" Margin="10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="70" />
                                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="120" />
                                    <DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <GroupBox Header="操作记录" Style="{StaticResource SectionGroupStyle}">
                            <ListBox ItemsSource="{Binding ActivityLog}" Margin="10" />
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
